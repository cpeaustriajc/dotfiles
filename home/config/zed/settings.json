// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)"
    },
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark"
    },
    "project_panel": {
        "dock": "right"
    },
    "outline_panel": {
        "dock": "right"
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "git_panel": {
        "dock": "right"
    },
    "agent_servers": {
        "codex-acp": {
            "type": "registry"
        },
        "claude-acp": {
            "default_config_options": {
                "fast": false,
                "effort": "low",
                "mode": "auto"
            },
            "type": "registry"
        }
    },
    "prettier": {
        "allowed": false
    },
    "edit_predictions": {
        "provider": "none"
    },
    "terminal": {
        "font_family": "Monaspace Neon NF",
        "blinking": "on"
    },
    "agent": {
        "dock": "left",
        "enabled": true,
        "button": true,
        "favorite_models": [],
        "model_parameters": []
    },
    "cursor_blink": true,
    "buffer_font_family": "Monaspace Krypton NF",
    "file_types": {
        "tailwindcss": [
            "*.css"
        ],
        "gotmpl": [
            ".tmpl"
        ]
    },
    "linked_edits": true,
    "relative_line_numbers": "enabled",
    "show_edit_predictions": true,
    "ensure_final_newline_on_save": true,
    "tab_size": 4,
    "vim_mode": true,
    "base_keymap": "VSCode",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "languages": {
        "PHP": {
            "language_servers": [
                "phptools",
                "!phpactor",
                "!intelephense"
            ]
        }
    }
}
